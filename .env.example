# ============================================================
# VIETCRAFT FRONTEND - PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================

# Backend API Endpoint (Trailing /api included or omitted based on client config)
# In production on Vercel: https://api.yourdomain.com/api
# If behind Nginx reverse proxy on same domain: /api
VITE_API_URL=https://api.yourdomain.com/api

# WebSocket Server URL for Real-time Chat
VITE_WS_URL=https://api.yourdomain.com

# Backend Root Origin (Used for serving static uploads/assets)
VITE_API_ORIGIN=https://api.yourdomain.com

# Cloudinary (Direct browser upload)
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
